--- a/lib/raop_buffer.c
+++ b/lib/raop_buffer.c
@@ -34,6 +34,8 @@
 #include "byteutils.h"
 
 #define RAOP_BUFFER_LENGTH 256
+/* consecutive "too late" drops before it is a stall rather than AAC-ELD resends */
+#define LATE_DISCARD_REPORT 32
 
 typedef struct {
     /* Data available */
@@ -60,6 +62,9 @@ struct raop_buffer_s {
     unsigned short first_seqnum;
     unsigned short last_seqnum;
 
+    /* diagnostic: packets dropped in a row by the "too late" test in enqueue */
+    unsigned int late_discards;
+
     /* RTP buffer entries */
     raop_buffer_entry_t entries[RAOP_BUFFER_LENGTH];
 };
@@ -188,8 +193,30 @@ raop_buffer_enqueue(raop_buffer_t *raop_buffer, unsigned char *data, unsigned sh
 
     /* If this packet is too late, just skip it */
     if (!raop_buffer->is_empty && seqnum_cmp(seqnum, raop_buffer->first_seqnum) < 0) {
+        /* AAC-ELD sends every packet three times (0 0 1 0 1 2 1 2 3 ...), so sequence
+         * numbers legitimately step backwards and this branch is taken constantly in
+         * normal playback - runs stay 1-2 long. Only a sustained run means the sender
+         * restarted its numbering behind us and nothing can get in any more, which is
+         * the case worth reporting: logging any earlier floods the receive thread. */
+        raop_buffer->late_discards++;
+        if (raop_buffer->late_discards == LATE_DISCARD_REPORT ||
+            (raop_buffer->late_discards > LATE_DISCARD_REPORT &&
