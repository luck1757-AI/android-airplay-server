+                       (unsigned) raop_buffer->first_seqnum,
+                       (unsigned) raop_buffer->last_seqnum);
+        }
         return 0;
     }
+    if (raop_buffer->late_discards >= LATE_DISCARD_REPORT) {
+        logger_log(raop_buffer->logger, LOGGER_ERR,
+                   "SEQ recovered after %u consecutive late packets, seqnum=%u first=%u",
+                   raop_buffer->late_discards, (unsigned) seqnum,
+                   (unsigned) raop_buffer->first_seqnum);
+    }
+    raop_buffer->late_discards = 0;
 
     /* Check that there is always space in the buffer, otherwise flush */
     if (seqnum_cmp(seqnum, raop_buffer->first_seqnum + RAOP_BUFFER_LENGTH) >= 0) {
