    <string name="setting_auto_start_desc">进入应用后自动开启投屏服务</string>
    <string name="setting_boot_auto_start">开机自动启动</string>
    <string name="setting_boot_auto_start_desc">盒子开机后自动开启投屏服务</string>
    <string name="setting_run_in_background">后台常驻</string>
