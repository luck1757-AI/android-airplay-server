    <!-- Settings: Connection -->
    <string name="setting_require_pin">需要配对码（测试功能）</string>
    <string name="setting_require_pin_desc">每次新设备连接时都要求输入 4 位配对码</string>
    <string name="setting_allow_new_conn">允许新设备接入</string>
    <string name="setting_allow_new_conn_desc">有新设备连接时，断开当前正在投屏的设备</string>

    <!-- Settings: Display -->
    <string name="setting_idle_preview">待机时显示画面层</string>
    <string name="setting_idle_preview_desc">等待连接时也保持视频画面层可见</string>
    <string name="setting_auto_fullscreen">自动全屏</string>
    <string name="setting_auto_fullscreen_desc">设备连接后自动进入全屏</string>
    <string name="setting_keep_screen_on">保持屏幕常亮</string>
    <string name="setting_keep_screen_on_desc">投屏过程中不让盒子休眠</string>
    <string name="setting_advertise_video">对外声明支持视频投屏</string>
    <string name="setting_advertise_video_desc">关闭后，视频将只以音频流的方式投送</string>
    <string name="setting_advertise_audio">对外声明支持音频投屏</string>
    <string name="setting_advertise_audio_desc">关闭后本机只能用于屏幕镜像，音乐类应用中将看不到本设备</string>
    <string name="setting_alac">声明支持 ALAC 编码</string>
    <string name="setting_alac_desc">在 mDNS 广播中提供 ALAC，用于无损音乐推送</string>
    <string name="setting_aac">声明支持 AAC 编码</string>
    <string name="setting_aac_desc">在 mDNS 广播中提供 AAC-ELD/AAC-LC，屏幕镜像的声音走这条通道</string>
    <string name="setting_launch_on_connect">连接时自动打开本应用</string>
    <string name="setting_launch_on_connect_desc">有设备连接时自动把本应用调到前台</string>
    <string name="setting_launch_on_connect_no_permission">点击授予「显示在其他应用上层」权限</string>
    <string name="setting_resolution">分辨率</string>
    <string name="setting_resolution_desc">对外声明的视频分辨率。盒子性能不足时，手动设为 1280x720 可明显降低卡顿和延迟</string>
    <string name="setting_resolution_placeholder">[宽]x[高]</string>
    <string name="setting_resolution_width">宽</string>
    <string name="setting_resolution_height">高</string>
    <string name="setting_max_fps">最高帧率</string>
    <string name="setting_max_fps_desc">对外声明的最高帧率。盒子解码吃力时，改为 30 会更稳</string>
    <string name="setting_max_fps_placeholder">帧率</string>
    <string name="setting_overscanned">过扫描补偿</string>
    <string name="setting_overscanned_desc">为存在过扫描的电视预留边缘像素，画面被切边时打开</string>
    <string name="chip_custom">自定义</string>
    <string name="chip_device_portrait">竖屏</string>
    <string name="chip_device_landscape">横屏</string>

    <!-- Settings: Decode -->
    <string name="setting_h265">H.265（HEVC）</string>
    <string name="setting_h265_desc">盒子支持时启用 H.265 解码。部分盒子的 H.265 解码流水线更长，画面发飘时可以关掉试试</string>
    <string name="setting_enforce_sdr">强制标记为 SDR</string>
    <string name="setting_enforce_sdr_desc">把画面标记为有限范围 SDR；关闭后允许 HDR 片源直通</string>
    <string name="setting_sw_alac">强制使用软件 ALAC 解码</string>
    <string name="setting_sw_alac_desc">始终用软件解码 ALAC 而非硬件解码，可能影响音频延迟</string>

    <!-- Settings: Developer -->
    <string name="setting_developer_options">高级选项</string>
    <string name="setting_developer_options_desc">显示面向进阶用户的调节项</string>
    <string name="setting_key_allow_frame_drop">允许解码器内部丢帧</string>
    <string name="setting_key_allow_frame_drop_desc">Android 10 及以上，允许解码器自行丢帧以跟上节奏</string>
    <string name="setting_realtime_decoder_priority">音频解码实时优先级</string>
    <string name="setting_realtime_decoder_priority_desc">为音频解码器申请实时调度优先级</string>
    <string name="setting_operating_rate">解码器运行速率</string>
    <string name="setting_operating_rate_desc">向解码器申请最高运行速率</string>
    <string name="chip_auto">自动</string>
    <string name="chip_on">开</string>
    <string name="chip_off">关</string>
    <string name="setting_low_latency">低延迟模式</string>
    <string name="setting_low_latency_desc">音频走低延迟解码通道；会增加功耗和 CPU 占用</string>
    <string name="setting_scheduled_output_buffer_release">按时间戳对齐出帧</string>
    <string name="setting_scheduled_output_buffer_release_desc">按每帧自带的时间戳安排显示时刻，并持续校正与发送端的时钟偏差。音画不同步时保持开启</string>
    <string name="setting_audio_delay">手动指定音频延迟</string>
    <string name="setting_audio_delay_desc">向手机报告一个自定义的音频延迟值。画面比声音慢就调大，反之调小</string>
    <string name="audio_delay_value">%d 毫秒</string>
    <string name="setting_audio_auto_buffer">自动调节音频缓冲</string>
    <string name="setting_audio_auto_buffer_desc">根据网络状况和盒子性能自动调整音频缓冲区；滑块决定能吸收多大的网络抖动。偏向「低延迟」则音画更同步，偏向「稳定」则更不容易出现爆音</string>
    <string name="audio_adaptive_value">%1$d%% (%2$s)</string>
    <string-array name="audio_adaptive_step_names">
        <item>延迟最低</item>
        <item>偏低延迟</item>
        <item>均衡</item>
        <item>偏稳定</item>
        <item>最稳定</item>
    </string-array>
    <string name="setting_audio_cushion_ms">固定音频缓冲（毫秒）</string>
    <string name="setting_audio_cushion_ms_desc">用来吸收网络和解码抖动的缓冲区：调小则延迟低，调大则杂音少。关闭上面的自动调节后此项才生效，建议 40–60</string>
    <string name="setting_oboe_buffer_frames">硬件输出缓冲（帧）</string>
    <string name="setting_oboe_buffer_frames_desc">本应用与音频设备之间的缓冲，仅用于吸收 CPU 调度抖动。保持 0 由系统自动决定</string>
    <string name="setting_debug_overlay">显示调试信息浮层</string>
    <string name="setting_debug_overlay_desc">在画面上叠加实时数据：编码格式、帧率、码率、抖动、帧数、丢帧</string>
    <string name="setting_benchmark_log">输出调试日志</string>
    <string name="setting_benchmark_log_desc">把实时数据写入 logcat：编码格式、帧率、码率、抖动、帧数、丢帧</string>

